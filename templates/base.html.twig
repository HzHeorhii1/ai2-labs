<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Weather App{% endblock %}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    {# Bootstrap 5 CSS (z CDN) #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    {% block stylesheets %}{% endblock %}
</head>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_location_index') }}">Pogodynka</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="{{ path('app_location_index') }}">Locations</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_measurement_index') }}">Measurements</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_location_new') }}">Add Location</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_measurement_new') }}">Add Measurement</a></li>
            </ul>
        </div>
    </div>
</nav>

<main class="container">
    {% block body %}{% endblock %}
</main>

{# Bootstrap 5 JS Bundle #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}{% endblock %}
</body>
</html>
